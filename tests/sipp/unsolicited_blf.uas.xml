<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  Unsolicited BLF NOTIFYs — UAS half.

  Listens on TCP port 15060 (the Contact URI port the paired UAC
  registered). After 1010's REGISTER, asterisk fires THREE deferred
  post-REGISTER tasks at this Contact:

    * cisco-bulkupdate: one REFER carrying 1010's line config (every
      type=cisco endpoint triggers it).
    * cisco-unsolicited-blf: one Event: presence NOTIFY per entry in
      1010's subscribe= list — 1030 and 1050, so two NOTIFYs.

  Order across the three tasks is non-deterministic — they run on
  separate serializer threads and asterisk schedules them
  independently. SIPp 3.7 can't express "any of N methods in any
  order" cleanly (a mandatory <recv request="X"> aborts the call if
  any other method arrives), so this scenario takes a different
  shape: each inbound is treated as its own call (-m 3 in run.sh).
  A single recv-send pair handles whichever request arrives; the
  action regex asserts it's a Cisco-shaped request.

  Per-message assertions (whichever message arrived):
    * Method is REFER or NOTIFY.
    * Cisco marker visible — `X-cisco-sis-*` header (asterisk's
      Supported list) or `urn:cisco:*` namespace in the body.
-->
<scenario name="cisco_unsolicited_blf_uas">

  <recv>
    <action>
      <ereg regexp="^(REFER|NOTIFY) "                   search_in="msg" check_it="true" assign_to="method"/>
      <ereg regexp="X-cisco-sis|urn:cisco:params"        search_in="msg" check_it="true" assign_to="cisco_marker"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Refer-Sub: false
      X-Test-Asserts: [$method] [$cisco_marker]
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="10, 20, 30, 50, 100, 200"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000"/>

</scenario>
