<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  Cisco unsolicited BLF NOTIFY round-trip.

  Exercises res_pjsip_cisco_unsolicited_blf: when a Cisco endpoint
  with a non-empty subscribe= list registers, asterisk pushes
  unsolicited Event: presence NOTIFYs to it — one per extension in
  the list — without any prior SUBSCRIBE from the phone. This is
  the third of the four signals Cisco firmware needs to classify a
  line button as BLF Speed Dial (the other three: SEP file, 200-OK
  optionsind body, bulkupdate REFER).

  Flow:
    1. REGISTER (no Authorization).
    2. asterisk 401 with WWW-Authenticate.
    3. REGISTER with Authorization (SIPp [authentication username=1010 password=ci-no-secret]).
    4. asterisk 200 OK — registration accepted.
    5. asterisk pushes an unsolicited NOTIFY for the first
       entry in 1010's subscribe= list (1030). Assert
       Event: presence header + Cisco RPID namespace in body.
    6. SIPp 200 OK to that NOTIFY.
    7. asterisk pushes a NOTIFY for the second entry (1050).
       Same assertion.
    8. SIPp 200 OK to that NOTIFY.

  Endpoint 1010 in tests/ci/pjsip.conf is configured with
  subscribe = 1030,1050 — exactly two entries, so we expect
  exactly two unsolicited NOTIFYs. asterisk dispatches them as
  deferred tasks (per ARCHITECTURE.md) so there's a small post-
  200-OK delay; SIPp's default recv timeout covers it.

  Unlike register_optionsind.xml, this scenario does NOT
  de-register at the end — the contact stays in place for any
  subsequent scenario to observe. The runner asterisk is fresh
  per matrix cell so cross-test contamination isn't a concern.
-->
<scenario name="cisco_unsolicited_blf">

  <!-- ============================================================
       Step 1: initial REGISTER (no Authorization).
       ============================================================ -->
  <send retrans="500">
    <![CDATA[

      REGISTER sip:[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];rport;branch=[branch]
      From: <sip:1010@[remote_ip]>;tag=[call_number]
      To: <sip:1010@[remote_ip]>
      Call-ID: [call_id]
      CSeq: 1 REGISTER
      User-Agent: Cisco-CP8865/12.1.1
      Max-Forwards: 70
      Contact: <sip:1010@[local_ip]:[local_port];transport=udp>;+sip.instance="<urn:uuid:00000000-0000-0000-0000-aabbccddeeff>";reg-id=1
      Expires: 3600
      Content-Length: 0

    ]]>
  </send>

  <!-- ============================================================
       Step 2: 401 Unauthorized — capture the challenge.
       ============================================================ -->
  <recv response="401" auth="true">
  </recv>

  <!-- ============================================================
       Step 3: REGISTER with Authorization.
       ============================================================ -->
  <send retrans="500">
    <![CDATA[

      REGISTER sip:[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];rport;branch=[branch]
      From: <sip:1010@[remote_ip]>;tag=[call_number]
      To: <sip:1010@[remote_ip]>
      Call-ID: [call_id]
      CSeq: 2 REGISTER
      User-Agent: Cisco-CP8865/12.1.1
      Max-Forwards: 70
      Contact: <sip:1010@[local_ip]:[local_port];transport=udp>;+sip.instance="<urn:uuid:00000000-0000-0000-0000-aabbccddeeff>";reg-id=1
      [authentication username=1010 password=ci-no-secret]
      Expires: 3600
      Content-Length: 0

    ]]>
  </send>

  <!-- ============================================================
       Step 4: 200 OK — registration accepted.
       ============================================================ -->
  <recv response="200">
  </recv>

  <!-- ============================================================
       Step 5: first unsolicited NOTIFY. Order across the
       subscribe= list isn't guaranteed (deferred task scheduling),
       so we don't pin which tuple id arrives first — just that the
       Cisco PIDF shape is present.
       ============================================================ -->
  <recv request="NOTIFY" crlf="true">
    <action>
      <ereg regexp="Event: *presence"                 search_in="msg" check_it="true" assign_to="evt_hdr_1"/>
      <ereg regexp="urn:cisco:params:xml:ns:pidf:rpid" search_in="msg" check_it="true" assign_to="cisco_ns_1"/>
      <ereg regexp="&lt;tuple id=&quot;10(30|50)&quot;" search_in="msg" check_it="true" assign_to="target_1"/>
    </action>
  </recv>

  <!-- X-Test-Asserts echoes the eregs' captures so sip-tester 3.7
       sees each variable referenced downstream — see
       bulkupdate_refer.xml for the rationale. -->
  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      X-Test-Asserts: [$evt_hdr_1] [$cisco_ns_1] [$target_1]
      Content-Length: 0

    ]]>
  </send>

  <!-- ============================================================
       Step 6: second unsolicited NOTIFY (the other entry from
       subscribe = 1030,1050).
       ============================================================ -->
  <recv request="NOTIFY" crlf="true">
    <action>
      <ereg regexp="Event: *presence"                 search_in="msg" check_it="true" assign_to="evt_hdr_2"/>
      <ereg regexp="urn:cisco:params:xml:ns:pidf:rpid" search_in="msg" check_it="true" assign_to="cisco_ns_2"/>
      <ereg regexp="&lt;tuple id=&quot;10(30|50)&quot;" search_in="msg" check_it="true" assign_to="target_2"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      X-Test-Asserts: [$evt_hdr_2] [$cisco_ns_2] [$target_2]
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="10, 20, 30, 50, 100, 200"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000"/>

</scenario>
